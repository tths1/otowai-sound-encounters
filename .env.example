# 公开静态功能无需环境变量。
# 若自行部署管理端，请在部署平台配置管理员鉴权与映射存储所需的环境变量；
# 不要把任何密钥提交到代码仓库。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PUBLIC_AI_ENABLED=false

# apiz MiniMax 公众音频（有服务端限额）。换新密钥后仅在 Netlify 中配置。
# 开启并点击朗读/保存会产生服务商费用；这里保持关闭。
AI_AUDIO_ENABLED=false
APIZ_API_KEY=
AI_AUDIO_TIMEOUT_MS=20000
AI_AUDIO_VOICE_ID=Japanese_CalmLady
